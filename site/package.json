{
  "name": "tenderscout-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "tokens": "node ../shared/build-tokens.js",
    "how": "node ../shared/how-it-decides.js",
    "images": "node scripts/brand-images.cjs",
    "prebuild": "node scripts/sync-shared.mjs && node scripts/seo-files.cjs",
    "dev": "next dev",
    "build": "next build",
    "export": "npm run prebuild && STATIC_EXPORT=1 next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "audit": "npm run export && node scripts/how-check.cjs && node scripts/a11y-motion.cjs && node scripts/audit.cjs",
    "seo": "node scripts/seo-files.cjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "framer-motion": "^14.9.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
